rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedGoogleAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'lakshaypamnani2@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidFileRecord(data) {
      return data.keys().hasAll([
          'id', 'displayName', 'originalName', 'mimeType', 'size', 'category', 'url', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'displayName', 'originalName', 'mimeType', 'size', 'category',
          'url', 'viewUrl', 'storagePath', 'storageType', 'chunkCount', 'uploadedBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidString(data.displayName, 1, 180)
        && isValidString(data.originalName, 1, 220)
        && isValidString(data.mimeType, 1, 120)
        && data.size is number && data.size >= 0 && data.size <= 20971520
        && data.category in ['zip', 'pdf', 'image', 'video', 'doc', 'other']
        && isValidString(data.url, 1, 500)
        && (!('viewUrl' in data) || isValidString(data.viewUrl, 0, 500))
        && (!('storagePath' in data) || isValidString(data.storagePath, 0, 500))
        && (!('storageType' in data) || data.storageType in ['firestore', 'url'])
        && (!('chunkCount' in data) || (data.chunkCount is number && data.chunkCount >= 1 && data.chunkCount <= 100))
        && (!('uploadedBy' in data) || isValidString(data.uploadedBy, 0, 128))
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function isValidFileChunk(data) {
      return data.keys().hasAll(['index', 'data'])
        && data.keys().hasOnly(['index', 'data'])
        && data.index is number && data.index >= 0 && data.index < 100
        && data.data is string && data.data.size() <= 900000;
    }

    match /test/connection {
      allow get: if isSignedIn();
    }

    // Cloud Firestore stores uploaded files ONLY (metadata + base64 chunks)
    match /files/{fileId} {
      allow get: if isValidId(fileId);
      allow list: if isVerifiedGoogleAdmin();
      allow create: if isVerifiedGoogleAdmin()
        && isValidId(fileId)
        && isValidFileRecord(incoming())
        && incoming().id == fileId;
      allow update: if isVerifiedGoogleAdmin()
        && isValidId(fileId)
        && isValidFileRecord(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt;
      allow delete: if isVerifiedGoogleAdmin() && isValidId(fileId);

      match /chunks/{chunkId} {
        allow get: if isValidId(fileId) && isValidId(chunkId);
        allow list: if isValidId(fileId);
        allow create, update: if isVerifiedGoogleAdmin()
          && isValidId(fileId)
          && isValidId(chunkId)
          && isValidFileChunk(incoming());
        allow delete: if isVerifiedGoogleAdmin() && isValidId(fileId) && isValidId(chunkId);
      }
    }
  }
}
